@model Project.DbManagement.ViewModels.BillViewModel

@{
    // ViewData["Title"] = "Cart";
    <style>
        #result {
            position: absolute;
            width: 100%;
            max-width: 360px;
            cursor: pointer;
            overflow-y: auto;
            max-height: 400px;
            box-sizing: border-box;
            z-index: 1001;
            padding-top: 20px;
        }
    </style>
}
<div class="d-flex flex-column">
    <div class="d-flex flex-row align-items-center" style="background:#e8eaed">
        <div class="flex-fill ms-2 me-0">
            <input value="@Model.Id" id="IDHD" hidden/>
            <span>Mã HD: <span style="font-weight:600">@Model.BillCode</span> </span>
        </div>
        <div class="search-product d-flex align-items-center">
            <div class="search-bar">

                <form class="search-form d-flex align-items-center">
                    <input type="text" name="search" style="outline: none;" id="search" value="@Model.NameClient"
                           placeholder="Phone number">
                    <button type="button" title="Thêm mới khách hàng" data-bs-toggle="modal"
                            data-bs-target="#themkhachhang#"><i class="fa-regular fa-plus" style="color: #a6a8ab;"></i>
                    </button>
                </form>
                <div>
                    <ul class="list-group pt-2" id="result"></ul>
                </div>
            </div>
        </div>
    </div>
    <!--Model Thêm nhanh khách hàng-->
    <div class="modal" id="themkhachhang" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-600">Thêm khách hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="row g-3">
                        <div class="col-md-12">
                            <label for="inputName5">Tên khách hàng</label>
                            <input type="text" class="form-control" id="inputTenKhachHang" required>
                        </div>
                        <div class="col-md-12">
                            <label for="inputPassword5">Điện thoại</label>
                            <input type="number" class="form-control" id="inputSDT" required>
                        </div>
                        <div class="col-md-12">
                            <label for="inputEmail5">Email</label>
                            <input type="email" class="form-control" id="inputEmail">
                        </div>

                        <div class="col-12">
                            <label for="inputAddress5">Địa chỉ</label>
                            <input type="text" class="form-control" id="inputDiaChi" placeholder="">
                        </div>
                        <div class="col-6">
                            <label for="inputCity">Ngày sinh</label>
                            <input type="date" class="form-control" id="inputNgaySinh">
                        </div>
                        <div class="col-6">
                            <label for="inputState">GioiTinh</label>
                            <fieldset class="d-flex flex-row mb-3 p-2">

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="gioitinh" value="1" checked>
                                    <label class="form-check-label" for="gridRadios1">
                                        Nam
                                    </label>
                                </div>
                                <div class="form-check ms-3">
                                    <input class="form-check-input" type="radio" name="gioitinh" value="0">
                                    <label class="form-check-label" for="gridRadios2">
                                        Nữ
                                    </label>
                                </div>
                            </fieldset>
                        </div>
                        <div class="d-flex flex-row text-center">
                            <button type="button" class="btn btn-secondary w-50 btn-block m-2" data-bs-dismiss="modal">
                                Bỏ qua
                            </button>
                            <button id="btn-saveKH" type="button" class="btn btn-primary w-50 btn-block m-2">Lưu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="cthd d-flex flex-column mt-2" style="height:570px;">
        @{
            var index = Model.listBillDetails.Count;
            var tsl = 0;
            var ttien = 0;
        }
        <div class="d-flex flex-column mb-2 p-2 overflow-auto scroll-cthd">
            @foreach (var item in Model.listBillDetails)
            {
                <div class="cart-item p-2">
                    <div class="cell-order">@index</div>
                    <div class="cell-active">
                        <img src="@item.Image" style="display: block; object-fit: cover;background-position: center; height: 50px; width: auto">
                    </div>
                        <div class="cell-content" style="margin-left: 20px; display: flex;">
                        <div class="cell-content-top">
                            @* <div class="cell-code">Code</div> *@
                            <div class="cell-name">@item.Name
                                <span class="badge bg-danger" style="color:#fff; font-weight:600">@item.Color - @item.Size</span>
                            </div>
                        </div>
                        <div class="cell-content-bottom" style="height: 30px; margin-top: 30px;">
                            <div style="width:30%">
                                <div class="number" style="display: flex;">
                                    <span class="minus" data-value="@item.Id"><i
                                            class="fa-solid fa-chevron-left"></i></span>
                                    <input type="number" class="changesl" value="@item.Quantity"/>
                                    <span class="plus" data-value="@item.Id"><i
                                            class="fa-solid fa-chevron-right"></i></span>
                                </div>
                            </div>
                            <div class="cell-changeprice2">@((item.Price * item.Quantity).ToString())</div>
                        </div>
                    </div>
                    <div class="cell-add">
                        <button class="btn" onclick="deleteHDCT('@item.Id','@item.IdBill')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                index--;
                tsl += @item.Quantity;
                ttien += (int)((decimal)item.Quantity * (decimal)item.Price);
            }
        </div>
    </div>
    <div class="d-flex flex-column bg-light mt-auto align-items-stretch" style="justify-content:center;font-size:24px">
        <div class="d-flex flex-row p-2 justify-content-center" style="font-size:18px;background:#e8eaed">
            <div class="flex-fill">
                <p>SL: </p>
            </div>
            <div class="flex-fill">
                <p id="tsl">@tsl</p>
            </div>
            <div class="flex-fill">
                <p>Tổng tiền: </p>
            </div>
            <div class="justify-content-end">
                <p style="text-align:right; padding-right:70px"><b id="tongtienhang">@ttien.ToString("n0")</b></p>
            </div>
        </div>
        <div class="d-flex flex-row mt-2 p-2">
            <div class="flex-fill pe-2">
                <div class="input-group">
                    <span class="input-group-text border border-secondary">
                        Ghi chú
                    </span>
                    <textarea class="form-control border border-secondary" aria-label="With textarea"
                              id="ghichu">@Model.Note</textarea>
                </div>
            </div>
            @* <button type="button" id="btnThanhToan" class="btn btn-primary fw-bold btn-block" *@
            @*         style="font-size:20px; width:400px"> *@
            @*     THANH TOÁN *@
            @* </button> *@
            <button type="button" id="btnThanhToan" class="btn btn-primary fw-bold btn-block"
                    style="font-size:20px; width:400px">
                Thanh toán
            </button>
        </div>
    </div>

</div>
<script>
    $(document).ready(function () {
        $.ajaxSetup({cache: false});
        $('#search').keyup(function () {
            $('#result').html('');
            $('#state').val('');
            var searchField = $('#search').val();
            var expression = new RegExp(searchField, "i");
            $.getJSON(`https://localhost:7095/api/KhachHang`, function (data) {
                $.each(data, function (key, value) {
                    if (value.sdt.search(expression) != -1 || value.ten.search(expression) != -1) {
                        $('#result').append('<li class="list-group-item link-class"><input value="' + value.idKhachHang + '" hidden />' + value.ten + ' | <span class="text-muted">' + value.sdt + '</span></li>');
                    }
                });
            });
        });
        $('#result').on('click', 'li', function () {
            var click_text = $(this).text().split('|');
            var id = $(this).find("input").val();
            suaKhachHang(id);
            $('#search').val($.trim(click_text[0]));
            $("#result").html('');
        });
    });
    // Mở modal thanh toán
    $("#btnThanhToan").on("click", function () {
        var activeTab = $(".tabs-box .tab").filter(".active");
        var elementValue = activeTab.find("span").attr("value");
        console.log(elementValue);
        $("#thanhtoanbody").load("/SellOff/ViewPayment/" + elementValue);
        $("#thanhtoan").modal("show");
    });

    //Thêm nhanh khách hàng
    $("#btn-saveKH").on("click", function () {
        var tenkh = $("#inputTenKhachHang").val();
        var sdt = $("#inputSDT").val();
        var email = $("#inputEmail").val();
        var dchi = $("#inputDiaChi").val();
        var dob = $("#inputNgaySinh").val();
        var gtinh = $('input[name="gioitinh"]:checked').val();
        var idhd = $("#IDHD").val();
        var khachHang = {
            IDKhachHang: idhd,
            Ten: tenkh,
            GioiTinh: gtinh,
            NgaySinh: dob,
            Email: email,
            DiaChi: dchi,
            SDT: sdt,
            Password: 123456
        };
        $.ajax({
            url: "/BanHangTaiQuay/AddKhachHang",
            async: false,
            type: 'POST',
            dataType: 'json',
            data: khachHang,
            success: function (response) {
                gethdct(idhd);
                $("#themkhachhang").modal("hide");
                toastr.success('Thêm khách hàng thành công', "Success Alert", {timeOut: 300});
            },
            error: function (response) {
                toastr.error('Thêm khách hàng thất bại', 'Error Alert', {timeOut: 300});
            }
        });
    })

    //Sửa khách hàng
    function suaKhachHang(IDKH) {
        {
            var IDHD = $("#IDHD").val();
            $.ajax({
                url: "/BanHangTaiQuay/UpdateKHinHD",
                type: 'GET',
                data: {
                    idkh: IDKH,
                    idhd: IDHD,
                },
                dataType: "json",
                success: function (response) {
                    gethdct(IDHD);
                },
                error: function (response) {
                    toastr.error('Sửa thất bại', "Error Alert", {timeOut: 300});
                },
            })
        }
    }

    //Xóa khách hàng
    var khinput = document.getElementById("search");
    khinput.addEventListener("blur", function (event) {
        var inputValue = event.target.value;
        var idhd = $("#IDHD").val();
        if (inputValue === '') {
            $.ajax({
                url: "/BanHangTaiQuay/DeleteKHinHD/" + idhd,
                async: false,
                type: 'GET',
                success: function (response) {
                    gethdct('@Model.Id');
                },
                error: function (response) {
                    //toastr.error('Xóa khách hàng thất bại', 'Error Alert', {timeOut: 300});
                }
            });
        }
    });

    //Update số lượng
    function UpdateSL(idbilldeltails, quantity) {
        $.ajax({
            url: "/SellOff/UpdateQuantity",
            type: 'POST',
            dataType: 'json',
            data: {
                idbilldeltails: idbilldeltails,
                quantity: quantity,
            },
            success: function (response) {
                if (response.success) {
                    gethdct('@Model.Id');
                    toastr.success('Cập nhật thành công', 'Success', { timeOut: 300 });
                } else {
                    toastr.error(response.message || 'Cập nhật thất bại', 'Error', { timeOut: 300 });
                    gethdct('@Model.Id');
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Cập nhật thất bại', 'Lỗi Ajax', { timeOut: 300 });
            }
        });
    }

    // Tăng giảm số lượng
    $('.minus').click(function () {
        var idbilldetails = $(this).data('value');
        var $input = $(this).parent().find('input');
        var count = parseInt($input.val()) - 1;
        count = count < 1 ? 1 : count;
        $input.val(count);
        $input.change();
        UpdateSL(idbilldetails, count);
        return false;
    });
    $('.plus').click(function () {
        var idbilldetails = $(this).data('value');
        var $input = $(this).parent().find('input');
        var count = parseInt($input.val()) + 1;
        $input.val(count);
        $input.change();
        UpdateSL(idbilldetails, count);
        return false;
    });
    //Thay đổi số lượng
    $('.changesl').on('input', function () {
        var idbilldetails = $(this).parent().find('span').data('value');
        let count = $(this).val();
        UpdateSL(idbilldetails, count);
    });

    //Lưu ghi chú
    var inputElement = document.getElementById("ghichu");
    inputElement.addEventListener("blur", function (event) {
        var inputValue = event.target.value;
        if (inputValue === '') {
            inputValue = null;
        }
        $.ajax({
            url: "https://localhost:7095/api/HoaDon/UpdateGhichu?idhd=@Model.Id&ghichu=" + inputValue,
            type: "PUT",
            dataType: "json",
            success: function () {
                gethdct('@Model.Id');
            },
            error: function (response) {
                toastr.error('Lưu ghi chú thất bại', 'Error Alert', {timeOut: 300});
            }
        });
    });
</script>