@model Project.DbManagement.ViewModels.PaySellOffViewModel
@{
    // var lstPttt = ViewData["lstPttt"] as List<PhuongThucThanhToan>;
}
<div class="d-flex flex-column" style="height:100%">
    <form class="row g-3 p-3 formthanhtoan">
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill text-start"><span id="nhanVien"></span>Employee: @Model.Employee</div>
            <div class="flex-fill text-end"><span id="ngay"></span>@Model.PaymentDate</div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label for="inputName5" class="form-label ">Bill Code: @Model.BillCode</label></div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label for="inputName5" class="form-label">Client</label></div>
            <div class="flex-fill text-end"> <span id="tenkh">@Model.Client</span></div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label class="form-label">Total Quantity</label></div>
            <div class="flex-fill text-end"> <span id="soLuong">@Model.TotalQuantity</span></div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label for="inputEmail5" class="form-label">Total Price</label></div>
            <div class="flex-fill text-end"> <input id="tongTienHang" value="@Model.TotalPrice" hidden /><span>@Model.TotalPrice?.ToString("n0")</span></div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label for="inputEmail5" class="form-label">Voucher </label></div>
            <div class="flex-fill text-end"><span id="giatrivoucher"></span></div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label for="inputEmail5" class="form-label">Payment</label></div>
            <div class="flex-fill text-end">
                <span id="khachCanTra"></span>
            </div>
        </div>
        <hr/>
        <div class="d-flex flex-row lh-1">
            <div class="flex-fill"><label for="inputState" class="form-label">Payment Method</label></div>
            <div class="flex-fill m-2">
                <input class="form-check-input" type="radio" name="pttt" value="Cash" checked>
                <label class="form-check-label" for="gridRadios1">
                    Cash
                </label>
            </div>
            <div class="flex-fill m-2">
                <input class="form-check-input" type="radio" name="pttt" value="VNPay" checked>
                <label class="form-check-label" for="gridRadios1">
                    VNPay
                </label>
            </div>
        </div>
        <hr/>
    </form>

    <div class="mt-auto text-danger" id="notification"></div>
    <div class="d-flex flex-row mt-auto">
        <button type="button" onclick="thanhToan('@Model.Id')" class="btn btn-primary fw-bold btn-block w-100" style="height:60px; font-size:24px">THANH TOÁN</button>
    </div>
</div>
<script>
    $(document).ready(function(){
        var tongtien = parseInt('@Model.TotalPrice');
        $("#khachCanTra").text(tongtien);
        // Sử dụng điểm tích
        $("#diemKHSD").keyup(function(){
            var tienkhachtra = tongtien;
            $("#khachCanTra").text(tienkhachtra.tolocalString());
        });
        // Sử dụng voucher
        $("#btn-voucher").on("click", function() {
            var voucher = $("#voucher").val();
        });
    })
</script>