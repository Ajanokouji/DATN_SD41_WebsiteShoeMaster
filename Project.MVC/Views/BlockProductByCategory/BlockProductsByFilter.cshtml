@model Project.MvcModule.Model.BlockProductsByFilterViewModel
<div class="container">
    <div class="row">
        <div class="col-lg-4 col-md-4">
            <div class="section-title">
                <h4>Sản phẩm mới</h4>
            </div>
        </div>
        <div class="col-lg-8 col-md-8">
            <ul class="filter__controls">
                <li class="active" data-filter="*">Tất cả</li>
                <li data-filter=".running">Chạy bộ</li>
                <li data-filter=".basketball">Bóng rổ</li>
                <li data-filter=".tennis">Tennis</li>
                <li data-filter=".gym">Tập gym</li>
            </ul>
        </div>
    </div>
    <div class="row property__gallery">
        <div class="col-lg-3 col-md-4 col-sm-6 mix running">
            <div class="product__item">
                <div class="product__item__pic set-bg" data-setbg="assets/images/product/product-1.jpg">
                    <div class="label new">Mới</div>
                    <ul class="product__hover">
                        <li><a href="assets/images/product/product-1.jpg" class="image-popup"><span class="arrow_expand"></span></a></li>
                        <li><a href="#"><span class="icon_heart_alt"></span></a></li>
                        <li><a href="#"><span class="icon_bag_alt"></span></a></li>
                    </ul>
                </div>
                <div class="product__item__text">
                    <h6><a href="#">Giày chạy bộ siêu nhẹ</a></h6>
                    <div class="rating">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>
                    <div class="product__price">$ 59.0</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 mix basketball">
            <div class="product__item">
                <div class="product__item__pic set-bg" data-setbg="assets/images/product/product-2.jpg">
                    <ul class="product__hover">
                        <li><a href="assets/images/product/product-2.jpg" class="image-popup"><span class="arrow_expand"></span></a></li>
                        <li><a href="#"><span class="icon_heart_alt"></span></a></li>
                        <li><a href="#"><span class="icon_bag_alt"></span></a></li>
                    </ul>
                </div>
                <div class="product__item__text">
                    <h6><a href="#">Giày bóng rổ cao cấp</a></h6>
                    <div class="rating">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>
                    <div class="product__price">$ 49.0</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 mix gym">
            <div class="product__item">
                <div class="product__item__pic set-bg" data-setbg="assets/images/product/product-3.jpg">
                    <div class="label stockout">Hết hàng</div>
                    <ul class="product__hover">
                        <li><a href="assets/images/product/product-3.jpg" class="image-popup"><span class="arrow_expand"></span></a></li>
                        <li><a href="#"><span class="icon_heart_alt"></span></a></li>
                        <li><a href="#"><span class="icon_bag_alt"></span></a></li>
                    </ul>
                </div>
                <div class="product__item__text">
                    <h6><a href="#">Giày tập gym đa năng</a></h6>
                    <div class="rating">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>
                    <div class="product__price">$ 59.0</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 mix tennis">
            <div class="product__item">
                <div class="product__item__pic set-bg" data-setbg="assets/images/product/product-4.jpg">
                    <ul class="product__hover">
                        <li><a href="assets/images/product/product-4.jpg" class="image-popup"><span class="arrow_expand"></span></a></li>
                        <li><a href="#"><span class="icon_heart_alt"></span></a></li>
                        <li><a href="#"><span class="icon_bag_alt"></span></a></li>
                    </ul>
                </div>
                <div class="product__item__text">
                    <h6><a href="#">Giày tennis chuyên nghiệp</a></h6>
                    <div class="rating">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>
                    <div class="product__price">$ 59.0</div>
                </div>
            </div>
        </div>
    </div>
</div>