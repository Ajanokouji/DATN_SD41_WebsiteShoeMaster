@model Project.Business.Model.BillModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Breadcrumb Begin -->
<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__links">
                    <a asp-controller="Home" asp-action="Index"><i class="fa fa-home"></i>Trang chủ</a>
                    <span>Đặt hàng thành công</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<!-- Thank You Section Begin -->
<section class="thank-you spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="thank-you__content">
                    <div class="thank-you__icon">
                        <i class="fa fa-check-circle"></i>
                    </div>
                    <h2>Đặt hàng thành công!</h2>
                    <p>Cảm ơn bạn đã đặt hàng tại Shop. Mã đơn hàng của bạn là: <strong>@Model.BillCode</strong></p>
                    
                    <div class="order-details">
                        <h4>Thông tin đơn hàng</h4>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="order-info">
                                    <p><strong>Họ và tên:</strong> @Model.CustomerName</p>
                                    <p><strong>Số điện thoại:</strong> @Model.CustomerPhone</p>
                                    <p><strong>Email:</strong> @Model.CustomerEmail</p>
                                    <p><strong>Địa chỉ:</strong> @Model.CustomerAddress</p>
                                    <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
                                    <p><strong>Trạng thái đơn hàng:</strong> @Model.Status</p>
                                    <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="order-summary">
                                    <h5>Tổng quan đơn hàng</h5>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Sản phẩm</th>
                                                <th>Số lượng</th>
                                                <th>Tổng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.BillDetails)
                                            {
                                                <tr>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@item.TotalPrice.ToString("N0") VNĐ</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="2"><strong>Tổng tiền</strong></td>
                                         @*        <td><strong>@Model.TotalAmount.ToString("N0") VNĐ</strong></td> *@
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="thank-you__actions">
                        <a asp-controller="Home" asp-action="Index" class="site-btn">Tiếp tục mua sắm</a>
                        <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id" class="site-btn">Xem chi tiết đơn hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Thank You Section End -->

