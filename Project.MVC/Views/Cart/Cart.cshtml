@model List<Project.Business.Model.CartItemModel>
@{
    ViewData["Title"] = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__links">
                    <a asp-controller="Home" asp-action="Index"><i class="fa fa-home"></i>Trang chủ</a>
                    <span>Giỏ hàng</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<!-- Shop Cart Section Begin -->
<section class="shop-cart spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center">
                        <h3>Giỏ hàng của bạn đang trống</h3>
                        <p>Hãy thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm</p>
                        <a asp-controller="Home" asp-action="Index" class="site-btn mt-4">Tiếp tục mua sắm</a>
                    </div>
                }
                else
                {
                    <div class="shop__cart__table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr data-id="@item.ProductId" data-size="@item.Size" data-color="@item.Color">
                                        <td class="cart__product__item">
                                            <img src="@item.ProductImage" alt="@item.ProductName" style="max-width: 90px;">
                                            <div class="cart__product__item__title">
                                                <h6>@item.ProductName</h6>
                                                <div class="cart__product__item__size">
                                                    <span>Size: @item.Size</span>
                                                    @if (!string.IsNullOrEmpty(item.Color))
                                                    {
                                                        <span>Màu: @item.Color</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="cart__price">@item.Price.ToString("N0") VNĐ</td>
                                        <td class="cart__quantity">
                                            <div class="pro-qty">
                                                <span class="dec qtybtn">-</span>
                                                <input type="text" value="@item.Quantity" class="quantity-input" readonly>
                                                <span class="inc qtybtn">+</span>
                                            </div>
                                        </td>
                                        <td class="cart__total">@((item.Price * item.Quantity).ToString("N0")) VNĐ</td>
                                        <td class="cart__close">
                                            <span class="icon_close remove-item"></span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="cart__btn">
                                <a asp-controller="Home" asp-action="Index">Tiếp tục mua sắm</a>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="cart__btn update__btn">
                                <a href="#" id="updateCart"><span class="icon_loading"></span> Cập nhật giỏ hàng</a>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="discount__content">
                                <h6>Mã giảm giá</h6>
                                <form action="#">
                                    <input type="text" placeholder="Nhập mã giảm giá">
                                    <button type="submit" class="site-btn">Áp dụng</button>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-4 offset-lg-2">
                            <div class="cart__total__procced">
                                <h6>Tổng giỏ hàng</h6>
                                <ul>
                                    <li>Tạm tính <span id="subtotal">@Model.Sum(x => x.Price * x.Quantity).ToString("N0") VNĐ</span></li>
                                    <li>Tổng tiền <span id="total">@Model.Sum(x => x.Price * x.Quantity).ToString("N0") VNĐ</span></li>
                                </ul>
                                <a asp-controller="Checkout" asp-action="Index" class="primary-btn">Tiến hành thanh toán</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
<!-- Shop Cart Section End -->

@section Scripts {
    <script>
        $(document).ready(function () {
            // Tăng số lượng
            $('.inc').click(function () {
                var $input = $(this).siblings('.quantity-input');
                var currentVal = parseInt($input.val());
                $input.val(currentVal + 1);
                updateItemTotal($(this).closest('tr'));
            });

            // Giảm số lượng
            $('.dec').click(function () {
                var $input = $(this).siblings('.quantity-input');
                var currentVal = parseInt($input.val());
                if (currentVal > 1) {
                    $input.val(currentVal - 1);
                    updateItemTotal($(this).closest('tr'));
                }
            });

            // Xóa sản phẩm
            $('.remove-item').click(function () {
                var $row = $(this).closest('tr');
                var productId = $row.data('id');
                var size = $row.data('size');

                $.ajax({
                    url: '@Url.Action("RemoveFromCart", "Cart")',
                    type: 'POST',
                    data: { productId: productId, size: size },
                    success: function (response) {
                        if (response.success) {
                            $row.remove();
                            updateCartTotal();
                            
                            // Nếu giỏ hàng trống, reload trang
                            if ($('.shop__cart__table tbody tr').length === 0) {
                                location.reload();
                            }
                        } else {
                            alert(response.message);
                        }
                    }
                });
            });

            // Cập nhật giỏ hàng
            $('#updateCart').click(function (e) {
                e.preventDefault();
                
                var updates = [];
                $('.shop__cart__table tbody tr').each(function () {
                    var $row = $(this);
                    var productId = $row.data('id');
                    var size = $row.data('size');
                    var color = $row.data('color');
                    var quantity = parseInt($row.find('.quantity-input').val());
                    
                    updates.push({
                        productId: productId,
                        size: size,
                        color: color,
                        quantity: quantity
                    });
                });
                
                // Cập nhật từng sản phẩm
                var promises = [];
                updates.forEach(function (item) {
                    var promise = $.ajax({
                        url: '@Url.Action("UpdateCart", "Cart")',
                        type: 'POST',
                        data: {
                            productId: item.productId,
                            quantity: item.quantity,
                            size: item.size,
                            color: item.color
                        }
                    });
                    promises.push(promise);
                });
                
                // Khi tất cả các request hoàn thành
                $.when.apply($, promises).done(function () {
                    updateCartTotal();
                    alert('Cập nhật giỏ hàng thành công');
                });
            });

            // Cập nhật tổng tiền của một sản phẩm
            function updateItemTotal($row) {
                var price = parseFloat($row.find('.cart__price').text().replace(/[^\d]/g, ''));
                var quantity = parseInt($row.find('.quantity-input').val());
                var total = price * quantity;
                $row.find('.cart__total').text(formatCurrency(total) + ' VNĐ');
                updateCartTotal();
            }

            // Cập nhật tổng tiền giỏ hàng
            function updateCartTotal() {
                var total = 0;
                $('.cart__total').each(function () {
                    total += parseFloat($(this).text().replace(/[^\d]/g, ''));
                });
                $('#subtotal').text(formatCurrency(total) + ' VNĐ');
                $('#total').text(formatCurrency(total) + ' VNĐ');
            }

            // Format số tiền
            function formatCurrency(number) {
                return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
            }
        });
    </script>
}

